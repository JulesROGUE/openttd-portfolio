 {
+	/* OpenTTD Portfolio : un clic sur une maison ouvre la fiche du projet de sa ville ;
+	 * les autres tuiles (industries, gares, dépôts...) n'ouvrent aucune fenêtre. */
+	extern bool PortfolioClickTile(TileIndex tile);
+	if (_game_mode == GM_NORMAL) return PortfolioClickTile(tile);
+
 	ClickTileProc *proc = _tile_type_procs[GetTileType(tile)]->click_tile_proc;
 	if (proc == nullptr) return false;
 	return proc(tile);
