# Conteneur web d'OpenTTD Portfolio : le navigateur exécute un port JavaScript du moteur
# (web/ottd), sans WebAssembly. Pendant le build, une version native d'OpenTTD 15.3 patchée
# génère la carte et relève tout ce que le moteur JavaScript rejoue (scripts/export-js.sh) ;
# le tout est servi par un petit serveur Node (fichiers statiques, gzip pré-calculé, cache).

FROM debian:bookworm AS base
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake python3 zlib1g-dev liblzma-dev libpng-dev libsdl2-dev curl ca-certificates patch xz-utils \
 && rm -rf /var/lib/apt/lists/*

FROM base AS build
WORKDIR /src
# 0) sources d'OpenTTD et OpenGFX (sommes SHA-256 épinglées)
COPY scripts/fetch-sources.sh ./scripts/
RUN ./scripts/fetch-sources.sh
# 1) moteur patché, en natif (les données des projets sont compilées dans le moteur)
COPY engine/ ./engine/
COPY data/ ./data/
COPY tools/ ./tools/
COPY gamescript/ ./gamescript/
COPY scripts/ ./scripts/
RUN ./scripts/prepare-src.sh && ./scripts/build-engine.sh
# 2) carte (script de jeu), relevé pour le moteur JavaScript, coquille web
COPY config/ ./config/
COPY web/ ./web/
RUN ./scripts/build-web.sh \
 && cd dist/openttd && find . -type f \( -name '*.bin' -o -name '*.js' -o -name '*.html' -o -name '*.css' -o -name '*.json' -o -name '*.ttf' \) -exec gzip -9 -k {} \;

FROM node:22-alpine
WORKDIR /app
COPY server/server.js ./
COPY --from=build /src/dist/openttd/ ./public/
ENV PORT=8080 PREFIX=/openttd
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:8080/openttd/health || exit 1
CMD ["node", "server.js"]
